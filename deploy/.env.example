# Copy to .env (git-ignored) and fill in.

# Public hostname. Use "localhost" for a local run.
SIM_DOMAIN=simsensor.example.org

# Let's Encrypt account email (expiry notices). Optional.
ACME_EMAIL=

# Database password. Generate one, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=

# First admin account (optional). Used only on the very first start, when no account exists.
# Left blank, the install starts with the default admin from the README
# (admin@simsensor.local): sign in, create your own admin, then deactivate the default one.
# Password: at least 8 characters.
SIM_ADMIN_EMAIL=
SIM_ADMIN_PASSWORD=

# Session cookie only over HTTPS. Set to false only for a plain-HTTP local run.
SIM_COOKIE_SECURE=true
